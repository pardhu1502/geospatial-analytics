# Copy this file to `.env` (in this `backend/` directory) and adjust as needed.
# See ARCHITECTURE.md for the authoritative list of variables.

# --- Database -----------------------------------------------------------
# Matches the docker-compose Postgres/PostGIS service: db=darukaa, user=darukaa,
# password=darukaa, exposed on localhost:5432.
DATABASE_URL=postgresql+psycopg2://darukaa:darukaa@localhost:5432/darukaa

# --- Auth / JWT (consumed by app/core/security.py) ---
JWT_SECRET_KEY=replace-with-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins for the FastAPI CORS middleware.
CORS_ORIGINS=http://localhost:5173
